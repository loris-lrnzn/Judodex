{
  "name": "judodex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/gen-sw.mjs && node scripts/gen-seo.mjs && node scripts/gen-llms-full.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "vite build && vite preview --port 4173 & sleep 3 && node scripts/audit-layout.mjs; kill %1",
    "links": "node scripts/merge-links.mjs",
    "links:check": "node scripts/merge-links.mjs --check",
    "seo": "node scripts/gen-seo.mjs && node scripts/gen-llms-full.mjs",
    "og": "node scripts/gen-og.mjs",
    "miniatures": "node scripts/gen-miniatures.mjs",
    "icone": "node scripts/gen-icone.mjs",
    "polices": "node scripts/gen-polices.mjs",
    "contraste": "node scripts/check-contrast.mjs",
    "prerender": "node scripts/prerender.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "prebuild": "playwright install chromium-headless-shell || echo \"playwright install a échoué\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "framer-motion": "^12.0.0",
    "html-to-image": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
